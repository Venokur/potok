# Скопируйте в .env, только если хотите переопределить демо-значения.
# `docker compose up --build` работает и без этого файла.

POSTGRES_PASSWORD=postgres

# Секрет подписи JWT. Должен совпадать у auth, rest и anon-ключа.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# anon-ключ, подписанный JWT_SECRET (role: anon).
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBvdG9rLWxvY2FsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjIzMDAwMDAsImV4cCI6MjA4ODAwMDAwMH0.LBch0AEseAYRU7pAaIjFnXCIf6T7a7y3aquAABL9Euo

# Публичный адрес приложения (используется GoTrue в письмах).
PUBLIC_URL=http://localhost:8080

# Адрес Supabase API. Пусто = origin, по которому открыто приложение.
SUPABASE_URL=
